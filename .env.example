# Copy this file to backend/.env for local development.
# No secrets are required to run this project -- extraction uses a local,
# free, rule-based engine (no LLM API key) and OCR uses local Tesseract.

# --- Storage ---
DATABASE_URL=sqlite:///./data/document_intelligence.db
UPLOAD_DIR=./data/uploads

# --- Document validation limits ---
MAX_PAGES=3
MAX_FILE_SIZE_MB=15

# --- OCR ---
# Set this only if Tesseract is not already on the system PATH.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Docker: usually not needed (apt-get install tesseract-ocr puts it on PATH)
TESSERACT_CMD=

# --- Financial validation tolerance ---
VALIDATION_TOLERANCE_ABS=1.0
VALIDATION_TOLERANCE_PCT=0.01

# --- Logging ---
LOG_LEVEL=INFO

# --- CORS ---
CORS_ALLOW_ORIGINS=["*"]
